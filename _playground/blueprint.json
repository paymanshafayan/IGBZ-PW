{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/admin.php?page=igbz",
	"preferredVersions": {
		"php": "8.2",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"phpExtensionBundles": [ "kitchen-sink" ],
	"constants": {
		"IGBZ_ENCRYPTION_KEY": "playground-demo-key-not-for-production",
		"WP_DEBUG": true,
		"WP_DEBUG_DISPLAY": true
	},
	"steps": [
		{
			"step": "login",
			"username": "admin",
			"password": "password"
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "woocommerce"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/paymanshafayan/IGBZ-WP",
				"ref": "main",
				"refType": "branch",
				"path": "/igbz-suite"
			},
			"options": {
				"activate": true,
				"targetFolderName": "igbz-suite"
			}
		}
	]
}
